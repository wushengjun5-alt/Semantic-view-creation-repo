# Snowflake Connection Configuration
# Copy this file to secrets.toml and fill in your credentials
# DO NOT commit secrets.toml to version control

# Option 1: OAuth/SSO Authentication (Recommended for enterprise)
# Use this for "Sign in using OAuth" browser-based authentication
[snowflake]
account = "te8232002.north-europe.azure"  # Extract from: te8232002.north-europe.azure.snowflakecomputing.com
user = "your-email@company.com"
authenticator = "externalbrowser"         # Enables OAuth/SSO authentication
role = "PRD_VISUALISER"                   # Optional
warehouse = "your-warehouse"              # Optional
database = "your-database"                # Optional
schema = "your-schema"                    # Optional

# Option 2: Password Authentication (Traditional)
# [snowflake]
# account = "te8232002.north-europe.azure"
# user = "your-username"
# password = "your-password"
# warehouse = "your-warehouse"       # Optional
# database = "your-database"         # Optional
# schema = "your-schema"             # Optional
# role = "your-role"                 # Optional
